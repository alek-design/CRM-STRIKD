{
  "rewrites": [
    {
      "source": "/_blob/:id",
      "destination": "/api/blob/:id"
    },
    {
      "source": "/f/:path*",
      "destination": "/api/f?path=:path*"
    },
    {
      "source": "/v",
      "destination": "/api/f"
    }
  ],
  "functions": {
    "api/setup.js": {
      "includeFiles": "supabase/**"
    },
    "api/push-check.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
